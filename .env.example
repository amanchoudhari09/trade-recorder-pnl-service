# Copy to .env for local development. Values below match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/trades

# Used only by the test suite. The database name MUST end in "_test":
# the tests wipe all tables and refuse to run against anything else.
TEST_DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/trades_test
